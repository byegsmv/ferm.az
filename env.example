# ========================================
# FermerMarket Environment Configuration
# Copy to .env and fill with real values
# ========================================

# DATABASE (Neon Cloud DB tövsiyə olunur)
DATABASE_URL="postgresql://neondb_owner:npg_xxx@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# JWT SECRETS (Generate unique long strings - min 32 chars each)
JWT_ACCESS_SECRET="your-super-secret-access-token-key-minimum-32-characters-long"
JWT_REFRESH_SECRET="your-super-secret-refresh-token-key-minimum-32-characters-long"

# NODE ENVIRONMENT
NODE_ENV="development"  # or "production"

# APP URL (for email links, redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"  # or "https://fermermarket.vercel.app"

# VERCEL (Production üçün)
NEXT_PUBLIC_VERCEL_URL="https://fermermarket.vercel.app"

# ========================================
# EMAIL & NOTIFICATIONS
# ========================================
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# WhatsApp Business (Optional)
WHATSAPP_BUSINESS_ACCOUNT_ID="xxxxxxxxx"
WHATSAPP_BUSINESS_PHONE_ID="xxxxxxxxx"
WHATSAPP_BUSINESS_ACCESS_TOKEN="xxxxxxxxx"

# ========================================
# PAYMENT PROVIDER (Optional)
# ========================================
PAYMENT_PROVIDER="manual"  # "manual" | "stripe" | "payriff" | "kapital"

# Stripe (if PAYMENT_PROVIDER="stripe")
STRIPE_SECRET_KEY="sk_live_xxxxxxxxx"
STRIPE_PUBLISHABLE_KEY="pk_live_xxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxx"

# Payriff (if PAYMENT_PROVIDER="payriff")
PAYRIFF_MERCHANT_ID="xxxxxxxxx"
PAYRIFF_SECRET_KEY="xxxxxxxxx"

# ========================================
# AI FEATURES (Optional)
# ========================================

# Anthropic Claude API (for product descriptions, SEO)
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Google Gemini (for agronomist AI diagnosis)
GEMINI_API_KEY="AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GOOGLE_GENERATIVE_AI_API_KEY="AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ========================================
# STORAGE & CDN
# ========================================

# Vercel Blob (for image uploads)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxx"

# Alternative: AWS S3
AWS_S3_REGION="eu-west-1"
AWS_S3_BUCKET="fermermarket-uploads"
AWS_ACCESS_KEY_ID="xxxxxxxxx"
AWS_SECRET_ACCESS_KEY="xxxxxxxxx"

# ========================================
# ERROR TRACKING & MONITORING
# ========================================

# Sentry
SENTRY_DSN="https://xxxxxx@sentry.io/xxxxxx"
SENTRY_ENVIRONMENT="production"
SENTRY_TRACES_SAMPLE_RATE="1.0"

# ========================================
# CACHING (Optional)
# ========================================

# Redis (for sessions, cache, rate limiting)
REDIS_URL="redis://localhost:6379"

# ========================================
# RATE LIMITING
# ========================================

# Rate limit window (milliseconds)
RATE_LIMIT_WINDOW_MS="900000"  # 15 minutes

# ========================================
# SECURITY
# ========================================

# CORS
CORS_ORIGIN="http://localhost:3000,https://fermermarket.vercel.app"

# ========================================
# LOGGING & ANALYTICS
# ========================================

# Vercel Analytics (automatic with @vercel/analytics)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=""

# ========================================
# DEVELOPER / DEBUG
# ========================================

# Set to "true" for verbose logging in development
DEBUG="false"

# Disable telemetry (Next.js)
NEXT_TELEMETRY_DISABLED="1"

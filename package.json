{
  "name": "fermermarket",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && (prisma migrate deploy || (echo 'retry 1/3 in 8s...' && node -e \"setTimeout(() => {}, 8000)\" && prisma migrate deploy) || (echo 'retry 2/3 in 15s...' && node -e \"setTimeout(() => {}, 15000)\" && prisma migrate deploy)) && next build",
    "start": "next start",
    "test": "jest",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:seed": "node prisma/seed.js",
    "monitor": "node server/monitor.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.14",
    "isomorphic-dompurify": "^3.23.0",
    "jsonwebtoken": "^9.0.2",
    "lenis": "^1.3.26",
    "lucide-react": "^1.34.0",
    "next": "^16.3.3",
    "next-intl": "^4.14.0",
    "postcss": "^8.5.26",
    "prisma": "^5.22.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.10.1",
    "resend": "^6.24.0",
    "slugify": "^1.6.6",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "swiper": "^14.2.0",
    "swr": "^2.5.1",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "node-fetch": "^3.3.2"
  }
